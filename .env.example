# My Learning Hub — Environment Configuration
# Copy this file to .env to configure local settings:
# cp .env.example .env

# Server Host and Port
LMS_HOST=127.0.0.1
LMS_PORT=8000

# Secret Key for session cookie signing (set a long random string in production)
LMS_SECRET_KEY=mylearninghub-secure-session-key-2026-prod

# Database Connection (Optional for local development, required for Vercel production)
# Leave blank to use local SQLite in data/lms.db
# For production (Neon PostgreSQL), configure in Vercel Project Settings > Environment Variables:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional OpenAI API Key for AI Study Assistant
# If omitted or left empty, the application uses its built-in local slide-grounded engine
OPENAI_API_KEY=
